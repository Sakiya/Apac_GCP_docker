# ==========================================
# Caddy 反向代理設定檔
# ==========================================

{
    # 全域設定，因為我們使用 Cloudflare Origin CA，不需要自動申請憑證。
    auto_https disable_certs
}

# ---------------------------------------------------------
# 共用安全性標頭 (Security Headers Snippet)
# ---------------------------------------------------------
(security_headers) {
    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.youtube.com *.ytimg.com *.googleapis.com *.google.com *.microsoft.com *.azure.com *.windows.net; style-src 'self' 'unsafe-inline' *.googleapis.com *.google.com *.microsoft.com; img-src 'self' data: *.youtube.com *.ytimg.com *.google.com *.googleapis.com *.gstatic.com *.microsoft.com; font-src 'self' data: *.gstatic.com *.googleapis.com; frame-src 'self' *.youtube.com *.google.com *.microsoft.com; connect-src 'self' *.google.com *.googleapis.com;"
        -Server
    }
}

# ---------------------------------------------------------
# 1. 網站 HTTPS (Cloudflare Full Strict)
# ---------------------------------------------------------
https://registration.onearttaipei.com {
    tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
    
    log {
        output file /var/log/caddy/oat_web.log
    }

    import security_headers
    reverse_proxy oat_web:80
}

# ---------------------------------------------------------
# 2. 網站 HTTP (本地端開發或內部測試)
# ---------------------------------------------------------
http://registration.onearttaipei.com, http://localhost {
    log {
        output file /var/log/caddy/oat_web.log
    }

    import security_headers
    reverse_proxy oat_web:80
}

# ---------------------------------------------------------
# 3. Portainer 監控後台
# ---------------------------------------------------------
http://monitor.onearttaipei.com {
    log {
        output file /var/log/caddy/portainer.log
    }

    # 移除伺服器標識
    header -Server

    reverse_proxy portainer:9000
}

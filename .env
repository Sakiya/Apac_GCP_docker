# === 環境變數範本 (.env) ===
# 此檔案是範本，不含真實密碼，可以進 git
# 請複製為 .env.local 並填入真實值，本地開發使用 .env.local

# --- 資料庫設定 ---
DB_HOST=db
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- 應用程式設定 ---
YII_DEBUG=false
YII_TRACE_LEVEL=0
APP_DIRNAME=/var/www/html/www
ADMIN_EMAIL=

# --- 安全性密碼 ---
GII_PASSWORD=

# --- 郵件伺服器設定 ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
